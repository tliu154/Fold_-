# ============================================================
# Fold_归匣 环境变量样例
# 复制为 .env 后填写；.env 已加入 .gitignore，密钥绝不进 Git
# ============================================================

# --- 认证（阶段 0 实做） ---
# 登录密码（单用户）
AUTH_PASSWORD=change-me
# 会话签名密钥（随机长字符串，泄露等于交出登录态）
SESSION_SECRET=change-me-to-a-long-random-string

# --- 数据目录（阶段 0 实做） ---
# SQLite 主库与 Markdown 仓库的根目录（相对项目根或绝对路径）
# 铁律：此目录绝不放进任何文件同步工具
DATA_DIR=./data

# --- AI 代理（占位，阶段 0 未使用） ---
# OpenAI 兼容接口；默认便宜模型；全部可切换，不写死
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
# 月度预算上限（元，超限拒绝调用）
AI_MONTHLY_BUDGET=

# --- 同步与审批策略（占位，阶段 0 未使用） ---
# create 类 op 是否自动批准（delete 永远必须人工批准，此开关无效）
AUTO_APPROVE_CREATE=false

# --- Obsidian 协作（占位，阶段 0 未使用） ---
# 松耦合：仅「整理新笔记」按钮使用；路径不存在或功能关闭时平台其余功能不受影响
OBSIDIAN_VAULT_PATH=
