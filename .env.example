# ============================================================
# Fold_归匣 环境变量样例（v0.6）
# 复制为 .env 后填写；.env 已加入 .gitignore，密钥绝不进 Git / 前端
# ============================================================

# --- 认证（骨架实做） ---
AUTH_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# --- 数据目录（骨架实做） ---
# SQLite 主库根目录；铁律：此目录绝不放进任何文件同步工具
DATA_DIR=./data

# --- AI 模型路由（v0.6 清单 1.5，一期先 DeepSeek 一家） ---
# 日常任务（管家 / 周报 / 摘要 / 整理提案 / 记下来）→ DeepSeek-Flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash       # 探针实测（2026-11-19）：可用 deepseek-flash / deepseek-v4-pro，无 deepseek-chat

# 联网资讯（Qwen 内置联网搜索）——二/三期接入，一期留空
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# 复杂规划 / 深度分析（GLM-5.3 或 Qwen4-Max 二选一）——二/三期接入
REASONING_API_KEY=
REASONING_BASE_URL=
REASONING_MODEL=

# 月度预算上限（元，超限拒绝；0 = 不限制）
AI_MONTHLY_BUDGET=0

# --- Obsidian 协作（二期，松耦合） ---
# 路径不存在或留空时，平台其余功能完全不受影响
OBSIDIAN_VAULT_PATH=
